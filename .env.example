# Copy to .env.local and fill in. Never commit real keys.

# SendGrid — powers the contact form and plan builder quotes (https://sendgrid.com)
# API key needs the "Mail Send" permission.
SENDGRID_API_KEY=
# Must be a sender (or domain) verified in SendGrid.
CONTACT_FROM="BLXCK Website <info@blxckmarketing.com>"

# Calendly booking URL linked from /contact
NEXT_PUBLIC_CALENDLY_URL=
