# Copy to .env.local and fill in. Never commit real keys.

# Resend — powers the contact form (https://resend.com)
RESEND_API_KEY=
# Verified sender once your domain is set up in Resend.
# Until then, Resend's test sender works for emails to the account owner.
CONTACT_FROM="BLXCK Website <onboarding@resend.dev>"

# Calendly booking URL linked from /contact
NEXT_PUBLIC_CALENDLY_URL=
